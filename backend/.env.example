# =============================================================================
# TorqueLine Motorcycle POS System - Backend Environment Configuration
# =============================================================================

# --- DATABASE CONFIGURATION ---
# Default for zero-config local testing:
DATABASE_URL=sqlite:///./pos_system.db

# --- CONNECTING TO SUPABASE (PostgreSQL) ---
# When you're ready to connect to Supabase, uncomment and fill in your Supabase connection string:
# Option 1: Transaction Pooler URI (Recommended, port 6543):
# DATABASE_URL=postgresql+psycopg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# Option 2: Direct Connection URI (port 5432):
# DATABASE_URL=postgresql+psycopg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# (Optional) Supabase API keys:
# SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
# SUPABASE_KEY=[YOUR-SUPABASE-ANON-KEY]
# SUPABASE_SERVICE_ROLE_KEY=[YOUR-SUPABASE-SERVICE-ROLE-KEY]

# --- SECURITY & JWT ---
JWT_SECRET_KEY=change-me-to-a-secure-random-secret-in-production-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS SETTINGS (allows frontend requests) ---
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# --- PERFORMANCE & LOGGING ---
LOG_LEVEL=INFO
RATE_LIMIT_PER_MINUTE=120
MAX_REQUEST_BODY_BYTES=1048576
